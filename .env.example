# Copy to .env (never commit .env). All API settings use the PARKRIGHT_ prefix.
PARKRIGHT_ENV=development
PARKRIGHT_HOST=127.0.0.1
PARKRIGHT_PORT=8400
# Bearer token cameras and the evaluation feed send. Required in production.
PARKRIGHT_INGEST_TOKEN=dev-ingest-token-change-me
# Which PerceptionProvider runs: `none` reports every space UNCERTAIN.
PARKRIGHT_PERCEPTION_PROVIDER=none
PARKRIGHT_FRAME_MAX_BYTES=2097152
# Frames captured longer ago than this (camera clock vs API clock) are recorded but not used.
PARKRIGHT_FRAME_MAX_AGE_MS=10000
# Spaces not observed for this long become UNCERTAIN.
PARKRIGHT_STALE_AFTER_MS=12000
# Ground-truth route: defaults to on except in production.
# PARKRIGHT_EVALUATION_ENABLED=true
PARKRIGHT_CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
# Future (server-side only, never sent to clients): NVIDIA / Nebius credentials.
# NVIDIA_API_KEY=
# NEBIUS_API_KEY=
