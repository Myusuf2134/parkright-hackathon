{
  "name": "parkright-hackathon",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/contracts/ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "uv run python -m parkright_api",
    "dev:web": "npm run dev -w @parkright/web",
    "dev:sim": "npm run dev -w @parkright/simulator",
    "test:camera": "uv run python scripts/test_camera.py",
    "contracts:generate": "uv run python packages/contracts/scripts/export_schema.py && npm run generate -w @parkright/contracts",
    "test": "uv run pytest && npm run check -w @parkright/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:sim": "npm run test -w @parkright/simulator",
    "test:sim:e2e": "npm run test:e2e -w @parkright/simulator",
    "calibration:check": "node scripts/generate-calibration.mjs --check",
    "dev:a0": "scripts/integration/api.sh",
    "test:integration:stub": "PARKRIGHT_SUITE=stub playwright test -c scripts/integration/playwright.config.ts",
    "test:integration:real": "playwright test -c scripts/integration/playwright.config.ts",
    "test:integration:a2": "PARKRIGHT_SUITE=a2 playwright test -c scripts/integration/playwright.config.ts",
    "dev:a2": "PARKRIGHT_PERCEPTION_PROVIDER=a2 scripts/integration/api.sh",
    "lint": "uvx --from ruff==0.17.0 ruff check --isolated --select E4,E7,E9,F --ignore E741 services tests experiments",
    "demo:hackathon": "node scripts/demo/start.mjs",
    "demo:hackathon:live": "node scripts/demo/start.mjs --live",
    "demo:check": "node scripts/demo/check.mjs",
    "demo:reset": "node scripts/demo/reset.mjs",
    "demo:stop": "node scripts/demo/stop.mjs",
    "test:demo:reliability": "PARKRIGHT_DEMO_RUNS=5 playwright test -c scripts/demo/playwright.config.ts",
    "demo:hackathon:garage": "node scripts/demo/start.mjs --garage",
    "calibration:garage": "node scripts/generate-garage-calibration.mjs",
    "calibration:garage:check": "node scripts/generate-garage-calibration.mjs --check",
    "test:garage": "playwright test -c scripts/garage/playwright.config.ts",
    "demo:showcase": "node scripts/demo/start.mjs --showcase",
    "demo:showcase:live": "node scripts/demo/start.mjs --showcase --live",
    "calibration:showcase": "node scripts/generate-showcase-calibration.mjs",
    "calibration:showcase:check": "node scripts/generate-showcase-calibration.mjs --check",
    "demo:ohio": "node scripts/demo/start.mjs --ohio",
    "demo:ohio:live": "node scripts/demo/start.mjs --ohio --live",
    "calibration:ohio": "node scripts/generate-ohio-calibration.mjs",
    "calibration:ohio:check": "node scripts/generate-ohio-calibration.mjs --check"
  }
}
